{
  "name": "jjc",
  "version": "0.1.0",
  "description": "Jessica James Consulting",
  "main": "src/js/index.js",
  "scripts": {
    "build:scss": "sass src/scss/main.scss src/css/main.css",
    "build:prefix": "postcss src/css/main.css -o src/css/main.css",
    "build": "npm-run-all build:scss build:prefix",
    "watch": "sass src/scss/main.scss src/css/main.css --watch",
    "serve": "http-server ./src -c-1 -o",
    "dev": "npm-run-all -p watch serve"
  },
  "browserslist": [
    "last 2 versions",
    "> 1%"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/chrisjamesbk/jjc"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "http-server": "^14.1.1",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.4.49",
    "postcss-cli": "^11.0.0",
    "sass": "^1.83.0"
  }
}
